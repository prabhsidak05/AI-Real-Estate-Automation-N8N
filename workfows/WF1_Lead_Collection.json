        "jsCode": "const item = $input.item.json;\nconst errors = [];\n\nif (!item.email) errors.push(\"Missing email\");\nif (!item.phone) errors.push(\"Missing phone\");\nif (!item.budget_min || !item.budget_max) errors.push(\"Missing budget range\");\n\nif (errors.length > 0) {\n  throw new Error(\"Validation failed: \" + errors.join(\", \"));\n}\n\nreturn { json: { ...item, validated: true } };"
