      "parameters": {
        "jsCode": "const webhookData = $('Receive & Process feedback').first().json.body;\nconst lead = $('Receive & Process feedback').first().json;\n\nconst raw = $input.item.json.output?.[0]?.content?.[0]?.text\n  || $input.item.json.message?.content \n  || $input.item.json.choices?.[0]?.message?.content \n  || $input.item.json.text;\n\nlet parsed;\ntry {\n  const cleaned = String(raw).replace(/```json|```/g, \"\").trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { sentiment: \"Neutral\", reason: \"Could not parse AI response\" };\n}\n\nreturn {\n  json: {\n    lead_id: webhookData.lead_id,\n    visit_id: webhookData.visit_id,\n    property_id: webhookData.property_id,\n    customer_name: lead.name,\n    rating: webhookData.rating,\n    comments: webhookData.comments,\n    sentiment: parsed.sentiment,\n    sentiment_reason: parsed.reason\n  }\n};"
      },
