      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "// Combine data from all three Get Rows nodes via their node names\nconst feedback = $('Get Feedback').all().map(i => i.json);\nconst bookings = $('Get Bookings').all().map(i => i.json);\nconst leads = $('Get Leads').all().map(i => i.json);\n\nconst totalLeads = leads.length;\nconst totalBookings = bookings.filter(b => b.status === 'Confirmed').length;\nconst conversionRate = totalLeads ? ((totalBookings / totalLeads) * 100).toFixed(1) : 0;\nconst avgRating = feedback.length ? (feedback.reduce((s,f) => s + Number(f.rating||0), 0) / feedback.length).toFixed(2) : 0;\n\nreturn { json: { totalLeads, totalBookings, conversionRate, avgRating } };"
      },
