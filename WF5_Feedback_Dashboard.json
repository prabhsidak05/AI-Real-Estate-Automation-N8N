      "parameters": {
        "jsCode": "function extractDateStr(raw) {\n  if (!raw) return null;\n  const str = String(raw).trim();\n  // Match YYYY-MM-DD regardless of what comes after (T, space, or nothing)\n  const match = str.match(/^(\\d{4}-\\d{2}-\\d{2})/);\n  return match ? match[1] : null;\n}\n\nconst yesterday = DateTime.now().setZone('Asia/Kolkata').minus({ days: 1 }).toFormat('yyyy-MM-dd');\n\nconst matchingVisits = items.filter(item => {\n  const visitDate = extractDateStr(item.json.visit_datetime);\n  return visitDate === yesterday;\n});\n\nreturn matchingVisits;"
      },
