    {
      "parameters": {
        "jsCode": "const lead = $('Parse AI').first().json; // replace with your actual Parse-AI/lead node name\nconst properties = items.map(item => item.json);\n\nconst leadLat = Number(lead.lat);\nconst leadLng = Number(lead.lng);\n\nfunction distanceKm(lat1, lon1, lat2, lon2) {\n  if (!lat1 || !lat2 || !lon1 || !lon2) return 9999;\n  const R = 6371;\n  const dLat = (lat2 - lat1) * Math.PI / 180;\n  const dLon = (lon2 - lon1) * Math.PI / 180;\n  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLon/2)**2;\n  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\n}\n\nconst matches = properties\n  .filter(p => Number(p.price) >= Number(lead.budget_min) && Number(p.price) <= Number(lead.budget_max))\n  .filter(p => p.type?.toLowerCase() === lead.property_type?.toLowerCase())\n  .map(p => ({ ...p, distance_km: distanceKm(leadLat, leadLng, Number(p.lat), Number(p.lng)) }))\n  .sort((a, b) => a.distance_km - b.distance_km)\n  .slice(0, 3);\n\nconst topMatch = matches.length > 0 ? matches[0] : null;\n\nconst matches_text = topMatch\n  ? `${topMatch.title} | ${topMatch.location} | Rs ${topMatch.price} | ${topMatch.bedrooms} BHK | ${topMatch.distance_km.toFixed(1)} km away`\n  : \"No matching properties found.\";\n\nconst top_match_property_id = topMatch ? topMatch.property_id : null;\nconst top_match_location = topMatch ? topMatch.location : null;\n\nconsole.log(\"Lead location:\", leadLat, leadLng);\nconsole.log(\"Ranked matches:\", matches.map(m => ({ id: m.property_id, location: m.location, distance_km: m.distance_km })));\n\nreturn {\n  json: {\n    lead,\n    matches,\n    matches_text,\n    top_match_property_id,\n    top_match_location\n  }\n};"
      },
