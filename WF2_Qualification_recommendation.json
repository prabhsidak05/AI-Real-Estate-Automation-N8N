      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// adjust the path below to match your actual AI node's output shape\nconst raw = $input.item.json.message?.content || $input.item.json.choices?.[0]?.message?.content;\n\nlet parsed;\ntry {\n  // strip markdown code fences if the model wrapped its JSON in ```json ... ```\n  const cleaned = raw.replace(/```json|```/g, \"\").trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { score: \"Warm\", reason: \"Could not parse AI response, defaulting to Warm\" };\n}\n\n// merge parsed score back with the original lead data flowing through\nreturn {\n  json: {\n    ...$('When Executed by Another Workflow').first().json, // adjust node name if different\n    score: parsed.score,\n    score_reason: parsed.reason\n  }\n};"
      },
